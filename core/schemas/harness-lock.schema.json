{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://generic-harness/schemas/harness-lock/v0",
  "title": "harness.lock v0",
  "description": "O que foi vendorizado no hospedeiro, de onde veio e com que hash (HG §4.2; BF §3.2, §9). Base para `update` (merge de 3 vias), `uninstall` (remove só o que está aqui) e `doctor` (arquivo do harness editado à mão).",
  "type": "object",
  "required": ["schema", "source", "harnessVersion", "installedAt", "tools", "files", "blocks"],
  "additionalProperties": false,
  "properties": {
    "schema": { "const": 0 },
    "source": {
      "type": "object",
      "required": ["url", "commit"],
      "additionalProperties": false,
      "properties": {
        "url": { "type": "string", "minLength": 1 },
        "ref": { "type": "string" },
        "commit": { "type": "string", "pattern": "^[0-9a-f]{40}$" }
      }
    },
    "harnessVersion": { "type": "string", "minLength": 1 },
    "installedAt": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}T" },
    "updatedAt": { "type": "string" },
    "tools": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "enum": ["claude-code", "cursor", "codex"] }
    },
    "files": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["path", "sha256", "from", "mode"],
        "additionalProperties": false,
        "properties": {
          "path": { "type": "string", "minLength": 1, "description": "Caminho no hospedeiro, relativo à raiz." },
          "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$", "description": "Hash do conteúdo instalado." },
          "from": { "type": "string", "minLength": 1, "description": "Caminho de origem no generic-harness." },
          "mode": {
            "description": "copy: arquivo do harness; generated: renderizado do perfil; merged: JSON do time em que o harness inseriu chaves (ex.: .claude/settings.json).",
            "enum": ["copy", "generated", "merged"]
          },
          "keys": { "type": "array", "items": { "type": "string" }, "description": "Para mode=merged: ponteiros JSON das chaves que o harness possui." }
        }
      }
    },
    "blocks": {
      "type": "array",
      "description": "Blocos gerenciados em arquivos do time (HG G1).",
      "items": {
        "type": "object",
        "required": ["file", "name", "sha256"],
        "additionalProperties": false,
        "properties": {
          "file": { "type": "string", "minLength": 1 },
          "name": { "enum": ["boundaries", "workflow", "docs"] },
          "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
        }
      }
    },
    "created": {
      "type": "array",
      "items": { "type": "string" },
      "description": "Arquivos e diretórios que não existiam antes do apply (uninstall remove só estes)."
    }
  }
}
